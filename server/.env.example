# Copy this file to .env and fill in your real values.

# --- Resend (RECOMMENDED for Render free plan: sends over HTTPS, not SMTP) ---
# 1. Sign up at https://resend.com using the SAME email as TO_EMAIL below.
# 2. Create an API key and paste it here.
# With the default sender (onboarding@resend.dev) Resend only delivers to your own account email.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# --- Gmail SMTP (fallback; used only if RESEND_API_KEY is empty. Blocked on Render free plan) ---
# Use an APP PASSWORD, not your normal Gmail password:
#   Google Account -> Security -> 2-Step Verification (must be ON)
#   -> App passwords -> create one for "Mail" -> copy the 16-char code.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=abdulrahman.digimarketing@gmail.com
SMTP_PASS=zlscdseiyqatgmud

# Where the notification email should go (your inbox).
TO_EMAIL=abdulrahman.digimarketing@gmail.com

# Backend port
PORT=5000

# Secret key to view stored submissions at GET /api/submissions.
# Call with ?key=... query or 'x-admin-key: ...' header. Keep it private.
ADMIN_KEY=rahman-admin-3f9k2a